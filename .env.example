# Google OAuth Credentials (Download from Google Cloud Console)
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create OAuth 2.0 Client ID (Web Application or Desktop)
# 3. Add redirect URI: http://localhost:8000/api/gmail/oauth2callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth2callback
